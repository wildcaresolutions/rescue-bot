# Required: Cloudflare AI Gateway (Unified Billing — one token covers every
# provider call routed through the gateway). Per-provider keys NOT needed.
AI_GATEWAY_TOKEN=              # dash.cloudflare.com → AI → AI Gateway → API tokens
# MAIN_CHAT_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# PHOTO_RECOGNIZER_MODEL=openai/gpt-4.1-mini

# Required: Cloudflare deployment
CLOUDFLARE_API_TOKEN=          # From https://dash.cloudflare.com/profile/api-tokens

# Optional: Evals judge (make eval / make eval-site)
# EVAL_JUDGE_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Use EVAL_JUDGE_MODEL=anthropic/claude-haiku-4-5 after Anthropic is configured
# as a working stored provider key in Cloudflare AI Gateway.

# Optional: Email sender (sent via Cloudflare Email Routing in prod).
# Report recipients are configured per tenant in the admin dashboard.
# REPORT_FROM_EMAIL=

# Optional: Watchdog Worker alerts (operator-only, NEVER tenant admins)
# OPS_EMAIL receives outage alerts from infra/watchdog/. This is the platform
# operator's address — distinct from tenant daily-report recipients.
# OPS_FROM_EMAIL must be a verified sender on your CF Email Routing config.
# Push to the watchdog Worker via: make cf-push-secrets-watchdog
# OPS_EMAIL=
# OPS_FROM_EMAIL=
