# 1Password secret references for rescue-bot.
#
# Copy this file to .env.op (gitignored) and customize the vault name if yours
# differs from "wildcare". Then any `make` target will auto-detect this file
# and wrap commands with `op run --env-file=.env.op --`. You sign into 1Password
# once per make invocation; secrets never touch disk.
#
# If you prefer plain dotenv, ignore this file and use .env.example → .env
# instead. The Makefile detects whichever file exists.

# ─── Cloudflare ──────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=op://wildcare/cloudflare-api-token/credential
AI_GATEWAY_TOKEN=op://wildcare/cloudflare-ai-gateway/credential

# ─── Session signing ─────────────────────────────────────────────────────────
SIGNING_SECRET=op://wildcare/signing-secret/password

# ─── Cloudflare Turnstile (bot challenge) ────────────────────────────────────
# Leave commented until you've provisioned a Turnstile widget and added the
# secret as a 1Password item.
# TURNSTILE_SECRET_KEY=op://wildcare/turnstile-secret/credential

# ─── Platform admin allowlist ────────────────────────────────────────────────
# Comma-separated list of operator emails (NOT tenant admins).
# Store as plain text in a 1Password secure note titled "platform-admin-emails".
# PLATFORM_ADMIN_EMAILS=op://wildcare/platform-admin-emails/value

# ─── Email (Cloudflare Email Routing on wildcaresolutions.org) ───────────────
# These come online after Email Routing is configured on the new domain. Create
# a 1Password item "email-config" with fields: from, ops_email, ops_from.
# REPORT_FROM_EMAIL=op://wildcare/email-config/from
# OPS_EMAIL=op://wildcare/email-config/ops_email
# OPS_FROM_EMAIL=op://wildcare/email-config/ops_from

# ─── External AI provider keys ───────────────────────────────────────────────
# Not needed. Every model call routes through Cloudflare AI Gateway with
# Unified Billing — Cloudflare bills your account directly, no per-provider
# keys to manage. The single AI_GATEWAY_TOKEN above is the only credential
# this worker holds for LLM access.
