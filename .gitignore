# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
web/widget-dist/
# web/public/ holds hand-authored static pages (platform.html, find.html, login.html,
# styles/, img/) copied to dist by Vite. Only widget.js — copied in from
# web/widget-dist/ by build:widget — is a build artifact and gets ignored.
web/public/widget.js
*.tgz

# Environment variables
.env
.env.op
.env.op.disabled
.env.local
.env.development.local
.env.test.local
.env.production.local

# Private notes that must NEVER leak into the OSS repo.
# audits/ contains security-audit findings (some unfixed) and the
# `.env.op.disabled` references the 1Password vault paths.
audits/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.crush/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Temporary files
tmp/
temp/

# Session exports from web interface
web/sessions-*.json
web/export-*.json

# Agent sessions and runtime data
sessions/
*.session
.claude/
session.db*
*.db
# Promptfoo eval framework
.promptfoo/
evals/promptfoo-results.json
promptfoo-harvested.yaml

# Photo eval corpus: keep harness/templates in git, keep real intake photos and
# generated model reports out of git by default.
evals/photo/inbox/*
!evals/photo/inbox/.gitkeep
evals/photo/fixtures/*
!evals/photo/fixtures/.gitkeep
evals/photo/labels.jsonl
evals/photo/reports/*
!evals/photo/reports/.gitkeep

# Wrangler local dev vars (contains API keys)
.dev.vars
workers/.dev.vars
# Worktree-aware local dev: PORT chosen at runtime by `make cf-dev`, written
# here so `make cf-stop` can target the right process. Per-worktree, ephemeral.
workers/.dev.port
# Worktree-isolated wrangler state. cf-dev writes to .wrangler/state-<hash>/
# where <hash> is derived from `git rev-parse --show-toplevel`. Each git
# worktree gets its own subdir; original .wrangler/state/ stays for back-compat.
workers/.wrangler/state-*/
site/promptfoo-results.json
workers/src/instructions.ts
workers/src/guides.ts
workers/scripts/migrate-data.sql
# Org-specific values for wrangler.toml generation. Copy org.env.example to
# org.env and fill in. Never commit (contains account/D1/Turnstile IDs).
# Note: workers/wrangler.toml is checked in as a STUB (REPLACE_VIA_GEN_WRANGLER
# placeholders) — locally regenerated to real values by gen-wrangler.js before
# any wrangler invocation. Don't commit the regenerated wrangler.toml; CI's
# verify-stub job catches drift.
org.env
.gstack/

# Playwright runtime artifacts
.playwright-cli/
workers/.playwright-cli/
test-results/
tmp-test-assets/
