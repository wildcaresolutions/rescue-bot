# Org-specific configuration for wrangler.toml generation.
#
# Copy this file to `org.env` (gitignored) and fill in your values, then run:
#   make cf-init-config        # generates workers/wrangler.toml from template
#   make cf-deploy             # deploys to your CF account
#
# In CI: each value is a typed GitHub Actions secret. The `deploy-test` and
# `deploy-prod` jobs pass them as env vars and gen-wrangler reads from
# process.env directly (no org.env file needed in CI).
#
# Required GH Actions secrets for forking orgs:
#   ORG_SLUG, ORG_DOMAIN, ACCOUNT_ID, DEV_D1_DATABASE_ID, TEST_D1_DATABASE_ID,
#   PROD_D1_DATABASE_ID, PROD_TURNSTILE_SITE_KEY

# ─── Org slug (resource-name prefix) ─────────────────────────────────────────
# Every Cloudflare resource provisioned for this deployment is prefixed with
# ORG_SLUG: worker (<ORG_SLUG>-bot, -bot-test, -bot-dev, -bot-watchdog), D1
# (<ORG_SLUG>-db, -db-test), Vectorize (<ORG_SLUG>-docs, -docs-test, -docs-dev),
# R2 (<ORG_SLUG>-assets, -assets-test, -media, -media-test).
#
# Pick a short identifier for your org. Lowercase, alphanumeric, hyphens
# allowed (DNS-label shape). 2-30 chars. Cannot be a reserved subdomain like
# 'admin', 'api', 'platform', 'www', 'embed' — see init-org.js for the full
# reserved list.
#
# Examples: wildcare, bay-rescue, acme-wildlife.
ORG_SLUG=wildcare

# ─── Cloudflare account ──────────────────────────────────────────────────────
# Find this in the CF dashboard sidebar (Workers & Pages → Account ID).
ACCOUNT_ID=00000000000000000000000000000000

# Optional AI Gateway ID. Leave blank to use Cloudflare's auto-created
# `default` gateway. The auth token itself belongs in `.env` as
# AI_GATEWAY_TOKEN. The deployment uses Unified Billing — Cloudflare charges
# the account directly for every routed call, no per-provider BYOK config.
AI_GATEWAY_ID=
AI_GATEWAY_ACCOUNT_ID=

# ─── Org domain (production routes) ──────────────────────────────────────────
# Used in wrangler.toml [env.production] routes:
#   <ORG_DOMAIN>, www.<ORG_DOMAIN>, admin.<ORG_DOMAIN>, *.<ORG_DOMAIN>/*
# This is the apex domain only — no protocol, no path, no port.
ORG_DOMAIN=example.org

# ─── D1 database IDs ─────────────────────────────────────────────────────────
# Create three D1 databases in your CF account, then paste their UUIDs here.
# `wrangler d1 create <ORG_SLUG>-db` (etc.) gets the UUIDs.
DEV_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
TEST_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
PROD_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# ─── Platform display name (optional) ───────────────────────────────────────
# The brand the SaaS operator presents to tenants. Shown in magic-link emails
# ("Sign in to ${PLATFORM_NAME}"), the unauthenticated /api/config payload
# (marketing landing page), and the admin-assistant system prompt. Empty
# defaults to "rescue-bot". OSS forks: set this to your own brand.
PLATFORM_NAME=

# ─── Embed host (optional) ──────────────────────────────────────────────────
# CDN-cached embed host the admin Publish UI uses in the partner snippet:
#   <script src="https://${PLATFORM_EMBED_HOST}/v1.js" data-tenant="...">
# Bind `embed.<your-domain>` to an R2 bucket named `${ORG_SLUG}-embed` via
# CF Dashboard → R2 → bucket → Custom Domains, then populate the bucket with
# `make cf-deploy-embed`. Empty → the admin Publish UI falls back to the
# worker-origin `${ORG_DOMAIN}/widget.js`, which Workers Assets already
# serves; the v1.js form is preferred for partner embedding because it
# decouples the URL from the worker host and benefits from edge caching.
PLATFORM_EMBED_HOST=

# ─── New-application notifications (optional) ────────────────────────────────
# Comma-separated emails notified when a new org submits the public
# /platform/apply form. Plaintext [vars] (rendered into wrangler.toml) — NOT a
# secret, so it lives here, not in .env. Empty → no notification is sent (the
# apply endpoint logs `apply-no-admin-recipients`). Every address must be a
# verified destination in your Cloudflare Email Routing config or the send
# fails. Example: ops@your-org.org,alerts@your-org.org
PLATFORM_ADMIN_EMAILS=

# ─── Turnstile sitekey (production) ──────────────────────────────────────────
# Real Turnstile sitekey for the org's domain. Test env uses CF's "always
# passes" key (1x00000000000000000000AA) hardcoded in the template — only
# prod needs a real key. Get it from CF Dashboard → Turnstile → site config.
PROD_TURNSTILE_SITE_KEY=0x0000000000000000000000

# ─── Watchdog Worker (optional) ──────────────────────────────────────────────
# The watchdog at infra/watchdog/ probes /health every 5 minutes and emails
# the operator on outage. OPTIONAL — leave blank if you don't want to deploy
# the watchdog. `make cf-deploy` (main worker) still works without these.
#
# Setup:
#   1. Create a KV namespace:
#        cd infra/watchdog && npx wrangler kv:namespace create WATCHDOG_KV
#      Paste the resulting ID below.
#   2. Set the probe URLs to your test + prod /health endpoints.
#   3. In .env, set OPS_EMAIL and OPS_FROM_EMAIL (these are secrets).
#   4. make cf-deploy-watchdog && make cf-push-secrets-watchdog
WATCHDOG_KV_ID=
WATCHDOG_HEALTH_URL_TEST=
WATCHDOG_HEALTH_URL_PROD=

# ─── NOT in this file ────────────────────────────────────────────────────────
# Secrets (AI_GATEWAY_TOKEN, SIGNING_SECRET,
# REPORT_FROM_EMAIL, PLATFORM_FROM_EMAIL (optional), TURNSTILE_SECRET_KEY,
# OPS_EMAIL, OPS_FROM_EMAIL) go in `.env` and are
# pushed to CF via the corresponding cf-push-secrets-* targets. They're NOT
# injected into wrangler.toml.
# (PLATFORM_ADMIN_EMAILS used to be here — it's now a plaintext [vars] value
# set above in this file, since a notification recipient list isn't sensitive.)
#
# PLATFORM_FROM_EMAIL is the FROM address for transactional auth mail
# (magic-link sign-in, invitee welcome). Optional — defaults to
# noreply@<domain of REPORT_FROM_EMAIL>. Set it explicitly if you want the
# auth-mail sender to differ from that default (e.g. hello@<domain>).
